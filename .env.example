# OpenRouter API Key (Required for multi-model LLM routing)
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Kraken API Credentials (Optional for Paper Trading; Required for Live Trading)
KRAKEN_API_KEY=your_kraken_api_key
KRAKEN_API_SECRET=your_kraken_api_secret

# Execution Mode: paper or live
EXECUTION_MODE=paper
INITIAL_PAPER_BALANCE=10000.0

# Trading Settings
TRADING_PAIRS=BTC/USD,ETH/USD,SOL/USD
LOOP_INTERVAL_SECONDS=60

# 2026 Best-Value Model Assignments (OpenRouter)
MODEL_SENTIMENT=deepseek/deepseek-v4-flash-0731
MODEL_TECHNICAL=deepseek/deepseek-v4.1-flash
MODEL_FUNDAMENTAL=deepseek/deepseek-v4-flash-0731
MODEL_BULL=deepseek/deepseek-v4.1-flash
MODEL_BEAR=deepseek/deepseek-v4.1-flash
MODEL_DEBATE=deepseek/deepseek-v4.1-flash
MODEL_TRADER=z-ai/glm-5.3-flash
MODEL_RISK=deepseek/deepseek-v4.1-flash
MODEL_FALLBACK=deepseek/deepseek-v4-flash-latest:free

# Risk Management
MAX_POSITION_SIZE_PCT=0.30
STOP_LOSS_PCT=0.04
DAILY_DRAWDOWN_LIMIT_PCT=0.10
MAX_TRADES_PER_SYMBOL_DAILY=10
